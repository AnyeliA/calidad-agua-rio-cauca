digraph ER {
 graph [rankdir=LR, fontname="Liberation Sans", pad=0.3, nodesep=0.5, ranksep=0.9, bgcolor="white"];
 node [shape=plaintext, fontname="Liberation Sans", fontsize=10];
 edge [color="#555555", fontname="Liberation Sans", fontsize=9, arrowsize=0.8];
estacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#dde6f4"><B>estacion</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_estacion_i">id_estacion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_estacion_d"><FONT COLOR="#2f5597">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_i">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="nombre_d"><FONT COLOR="#2f5597">UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cercana_puerto_tejada_i">cercana_puerto_tejada</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="cercana_puerto_tejada_d"><FONT COLOR="#2f5597">0/1</FONT></TD></TR></TABLE>>];
muestreo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#dde6f4"><B>muestreo</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_muestreo_i">id_muestreo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_muestreo_d"><FONT COLOR="#2f5597">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_estacion_i">id_estacion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_estacion_d"><FONT COLOR="#2f5597">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_i">fecha</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="fecha_d"> </TD></TR><TR><TD ALIGN="LEFT" PORT="anio_i">anio</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="anio_d"><FONT COLOR="#2f5597">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mes_i">mes</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="mes_d"><FONT COLOR="#2f5597">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="duplicado_fecha_estacion_i">duplicado_fecha_estacion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="duplicado_fecha_estacion_d"><FONT COLOR="#2f5597">0/1</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ica5_i">ph, od, sst, dqo, conductividad</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="ica5_d"><FONT COLOR="#2f5597">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="otras_i">temperatura, turbiedad, dbo, …</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="otras_d"> </TD></TR><TR><TD ALIGN="LEFT" PORT="nota_i">(39 variables medidas)</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT" PORT="nota_d"> </TD></TR></TABLE>>];
clasificacion_ica [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#dde6f4"><B>clasificacion_ica</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_muestreo_i">id_muestreo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_muestreo_d"><FONT COLOR="#2f5597">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="od_pct_sat_i">od_pct_sat</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="od_pct_sat_d"> </TD></TR><TR><TD ALIGN="LEFT" PORT="subs_i">i_od … i_ph</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="subs_d"><FONT COLOR="#2f5597">subíndices</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ica_i">ica</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="ica_d"><FONT COLOR="#2f5597">CHECK 0–1</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="categoria_i">categoria</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="categoria_d"><FONT COLOR="#2f5597">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="clase_modelo_i">clase_modelo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="clase_modelo_d"><FONT COLOR="#2f5597">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="metodo_i">metodo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="metodo_d"> </TD></TR></TABLE>>];
modelo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#dde6f4"><B>modelo</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_modelo_i">id_modelo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_modelo_d"><FONT COLOR="#2f5597">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nv_i">nombre, version</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="nv_d"><FONT COLOR="#2f5597">UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="algoritmo_i">algoritmo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="algoritmo_d"> </TD></TR><TR><TD ALIGN="LEFT" PORT="periodo_entrenamiento_i">periodo_entrenamiento</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="periodo_entrenamiento_d"> </TD></TR><TR><TD ALIGN="LEFT" PORT="periodo_prueba_i">periodo_prueba</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="periodo_prueba_d"> </TD></TR><TR><TD ALIGN="LEFT" PORT="variables_entrada_i">variables_entrada</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="variables_entrada_d"> </TD></TR><TR><TD ALIGN="LEFT" PORT="parametros_i">parametros</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="parametros_d"><FONT COLOR="#2f5597">JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="met_i">accuracy … f1_macro</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="met_d"><FONT COLOR="#2f5597">CHECK 0–1</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ruta_archivo_i">ruta_archivo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="ruta_archivo_d"> </TD></TR><TR><TD ALIGN="LEFT" PORT="flags_i">es_control, activo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="flags_d"><FONT COLOR="#2f5597">0/1</FONT></TD></TR></TABLE>>];
prediccion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#dde6f4"><B>prediccion</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_prediccion_i">id_prediccion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_prediccion_d"><FONT COLOR="#2f5597">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_modelo_i">id_modelo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_modelo_d"><FONT COLOR="#2f5597">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_hora_i">fecha_hora</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="fecha_hora_d"> </TD></TR><TR><TD ALIGN="LEFT" PORT="entradas_i">entradas</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="entradas_d"><FONT COLOR="#2f5597">JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="categoria_predicha_i">categoria_predicha</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="categoria_predicha_d"><FONT COLOR="#2f5597">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tiempo_respuesta_ms_i">tiempo_respuesta_ms</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="tiempo_respuesta_ms_d"> </TD></TR></TABLE>>];
registro_carga [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#dde6f4"><B>registro_carga</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_carga_i">id_carga</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_carga_d"><FONT COLOR="#2f5597">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_hora_i">fecha_hora</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="fecha_hora_d"> </TD></TR><TR><TD ALIGN="LEFT" PORT="archivo_origen_i">archivo_origen</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="archivo_origen_d"> </TD></TR><TR><TD ALIGN="LEFT" PORT="registros_cargados_i">registros_cargados</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="registros_cargados_d"> </TD></TR><TR><TD ALIGN="LEFT" PORT="registros_con_ica_i">registros_con_ica</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="registros_con_ica_d"> </TD></TR><TR><TD ALIGN="LEFT" PORT="observacion_i">observacion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="observacion_d"> </TD></TR></TABLE>>];

 estacion:id_estacion_d:e -> muestreo:id_estacion_i:w [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1 : N"];
 muestreo:id_muestreo_d:e -> clasificacion_ica:id_muestreo_i:w [arrowhead=teeodot, arrowtail=teetee, dir=both, label="1 : 0..1"];
 modelo:id_modelo_d:e -> prediccion:id_modelo_i:w [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1 : N"];
 {rank=same; estacion; modelo}
 {rank=same; muestreo; prediccion}
 {rank=same; clasificacion_ica; registro_carga}
 prediccion -> registro_carga [style=invis];
 estacion -> modelo [style=invis]; muestreo -> prediccion [style=invis];
}